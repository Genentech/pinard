#!/usr/bin/env bash
# pinard-picker — fzf session switcher for pinard tmux sockets
# Bind to prefix+f in tmux: bind f display-popup -E -w 70% -h 60% "pinard-picker"
#
# When run inside a pinard socket: shows sessions on that socket (switch-client).
# When run outside or with --all: shows all pinard sessions across sockets.

set -euo pipefail

current_socket="${TMUX_PINARD_SOCKET:-}"

_list_sessions() {
  local uid
  uid="$(id -u)"
  local sock_dir="/tmp/tmux-${uid}"
  [[ -d "$sock_dir" ]] || return

  for sock in "$sock_dir"/pinard-*; do
    [[ -S "$sock" ]] || continue
    local socket_name="${sock##*/}"
    local vignoble="${socket_name#pinard-}"
    tmux -L "$socket_name" list-sessions -F "${socket_name}:#{session_name}" 2>/dev/null | while read -r entry; do
      local sess="${entry#*:}"
      if [[ "$sess" == "conductor" ]]; then
        echo "$entry	[$vignoble] conductor"
      else
        echo "$entry	[$vignoble] $sess"
      fi
    done
  done
}

_preview() {
  local target="$1"
  local socket="${target%%:*}"
  local sess="${target#*:}"
  tmux -L "$socket" capture-pane -t "$sess" -p 2>/dev/null || echo "(no output)"
}

if [[ "${1:-}" == "--preview" ]]; then
  _preview "$2"
  exit 0
fi

self="$(readlink -f "$0")"

selected="$(_list_sessions | column -t -s'	' | fzf \
  --prompt="session> " \
  --header="Enter=attach  Esc=cancel" \
  --preview="$self --preview {1}" \
  --preview-window=right:60% \
  --with-nth=2.. \
  | awk '{print $1}')"

[[ -z "$selected" ]] && exit 0

socket="${selected%%:*}"
sess="${selected#*:}"

if [[ "$socket" == "$current_socket" && -n "$TMUX" ]]; then
  tmux switch-client -t "$sess"
else
  exec tmux -L "$socket" attach -t "$sess"
fi
