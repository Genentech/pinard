{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pinard Ontology File Meta-Schema",
  "description": "Validates a pinard domain (or core) ontology YAML/JSON file",
  "type": "object",
  "required": ["domain", "version", "entities", "edges"],
  "additionalProperties": false,
  "properties": {
    "domain":    {"type": "string", "minLength": 1},
    "version":   {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "group_ids": {"type": "array", "items": {"type": "string"}},
    "suppressed":{"type": "array", "items": {"type": "string"}},
    "entities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "is_a":       {"type": "string"},
          "description":{"type": "string"},
          "properties": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type":        {"type": "string", "enum": ["string","integer","number","boolean","array","object"]},
                "description": {"type": "string"},
                "format":      {"type": "string"},
                "minimum":     {"type": "number"},
                "maximum":     {"type": "number"},
                "enum":        {"type": "array"},
                "items":       {"type": "object"}
              }
            }
          },
          "required": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "edges": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["pairs"],
        "additionalProperties": false,
        "properties": {
          "description": {"type": "string"},
          "pairs": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {"type": "string"},
              "minItems": 2,
              "maxItems": 2
            }
          }
        }
      }
    }
  }
}
